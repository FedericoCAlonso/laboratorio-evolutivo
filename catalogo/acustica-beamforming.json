  "codigoEvaluacion": "// Parámetros físicos del arreglo y fases de los transductores\nconst p0 = vars.fase0, p1 = vars.fase1, p2 = vars.fase2, p3 = vars.fase3, p4 = vars.fase4, p5 = vars.fase5;\nconst a0 = Math.max(0.05, vars.amp0), a1 = Math.max(0.05, vars.amp1), a2 = Math.max(0.05, vars.amp2);\nconst a3 = Math.max(0.05, vars.amp3), a4 = Math.max(0.05, vars.amp4), a5 = Math.max(0.05, vars.amp5);\n\n// Separación estándar lambda / 2 -> factor de retardo k*d = pi\nconst kx0 = -2.5 * Math.PI, kx1 = -1.5 * Math.PI, kx2 = -0.5 * Math.PI;\nconst kx3 = 0.5 * Math.PI, kx4 = 1.5 * Math.PI, kx5 = 2.5 * Math.PI;\n\nlet potenciaMaxima = 0.0001, anguloPico = 0.0, potenciaEnObjetivo = 0.0;\n\nif (!globalThis._bfPotBuf) {\n  globalThis._bfPotBuf = new Float64Array(91);\n  globalThis._bfSinBuf = new Float64Array(91);\n  globalThis._bfGradBuf = new Float64Array(91);\n  for (let idx = 0; idx < 91; idx++) {\n    const g = -90.0 + idx * 2.0;\n    globalThis._bfGradBuf[idx] = g;\n    globalThis._bfSinBuf[idx] = Math.sin((g * Math.PI) / 180.0);\n  }\n}\nconst potBuf = globalThis._bfPotBuf;\nconst sinBuf = globalThis._bfSinBuf;\nconst gradBuf = globalThis._bfGradBuf;\n\nfor (let idx = 0; idx < 91; idx++) {\n  const s = sinBuf[idx], g = gradBuf[idx];\n  const f0 = p0 + kx0 * s, f1 = p1 + kx1 * s, f2 = p2 + kx2 * s;\n  const f3 = p3 + kx3 * s, f4 = p4 + kx4 * s, f5 = p5 + kx5 * s;\n  const re = a0*Math.cos(f0) + a1*Math.cos(f1) + a2*Math.cos(f2) + a3*Math.cos(f3) + a4*Math.cos(f4) + a5*Math.cos(f5);\n  const im = a0*Math.sin(f0) + a1*Math.sin(f1) + a2*Math.sin(f2) + a3*Math.sin(f3) + a4*Math.sin(f4) + a5*Math.sin(f5);\n  const pot = re * re + im * im;\n  potBuf[idx] = pot;\n  if (pot > potenciaMaxima) { potenciaMaxima = pot; anguloPico = g; }\n  if (Math.abs(g - 25.0) <= 2.0) potenciaEnObjetivo = pot;\n}\n\nconst invMax = 1.0 / (potenciaMaxima || 1.0);\nlet maxLobulo = 0.0, anchoHaz = 0.0;\nfor (let idx = 0; idx < 91; idx++) {\n  const norm = potBuf[idx] * invMax;\n  const g = gradBuf[idx];\n  const db = 10.0 * Math.log10(norm > 1e-4 ? norm : 1e-4);\n  if (db >= -3.0 && Math.abs(g - anguloPico) < 35.0) anchoHaz += 2.0;\n  if (Math.abs(g - 25.0) > 18.0 && norm > maxLobulo) maxLobulo = norm;\n}\nconst sll = 10.0 * Math.log10(maxLobulo > 1e-4 ? maxLobulo : 1e-4);\nconst objDirectividad = Math.abs(anguloPico - 25.0) * 2.5 + Math.max(0, 36.0 - potenciaEnObjetivo) * 1.5;\nconst objSLL = (sll + 30.0) * 1.8 + Math.max(0, anchoHaz - 20) * 0.5;\nreturn [objDirectividad, Math.max(0.1, objSLL)];",
