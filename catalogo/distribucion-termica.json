  "codigoEvaluacion": "// Entorno térmico por defecto y dimensiones de la placa\nconst tAmbiente = 25.0, anchoPlaca = 100.0, altoPlaca = 80.0;\nconst halfW = 50.0, halfH = 40.0, invFact = 1.0 / (1.5 * 0.45);\nconst c0x = vars.xCPU, c0y = vars.yCPU, c0a = 25.0 * invFact, c0r = 9.0;\nconst c1x = vars.xGPU, c1y = vars.yGPU, c1a = 18.0 * invFact, c1r = 7.5;\nconst c2x = vars.xVRM, c2y = vars.yVRM, c2a = 12.0 * invFact, c2r = 6.5;\nconst c3x = vars.xMEM, c3y = vars.yMEM, c3a = 10.0 * invFact, c3r = 6.0;\n\n// Solapamiento físico entre chips y márgenes de borde\nlet solapamientoMm = 0;\nconst d01 = Math.hypot(c0x - c1x, c0y - c1y), r01 = c0r + c1r + 3.0; if (d01 < r01) solapamientoMm += (r01 - d01);\nconst d02 = Math.hypot(c0x - c2x, c0y - c2y), r02 = c0r + c2r + 3.0; if (d02 < r02) solapamientoMm += (r02 - d02);\nconst d03 = Math.hypot(c0x - c3x, c0y - c3y), r03 = c0r + c3r + 3.0; if (d03 < r03) solapamientoMm += (r03 - d03);\nconst d12 = Math.hypot(c1x - c2x, c1y - c2y), r12 = c1r + c2r + 3.0; if (d12 < r12) solapamientoMm += (r12 - d12);\nconst d13 = Math.hypot(c1x - c3x, c1y - c3y), r13 = c1r + c3r + 3.0; if (d13 < r13) solapamientoMm += (r13 - d13);\nconst d23 = Math.hypot(c2x - c3x, c2y - c3y), r23 = c2r + c3r + 3.0; if (d23 < r23) solapamientoMm += (r23 - d23);\n\nconst m0x = halfW - Math.abs(c0x); if (m0x < c0r) solapamientoMm += (c0r - m0x) * 2;\nconst m0y = halfH - Math.abs(c0y); if (m0y < c0r) solapamientoMm += (c0r - m0y) * 2;\nconst m1x = halfW - Math.abs(c1x); if (m1x < c1r) solapamientoMm += (c1r - m1x) * 2;\nconst m1y = halfH - Math.abs(c1y); if (m1y < c1r) solapamientoMm += (c1r - m1y) * 2;\nconst m2x = halfW - Math.abs(c2x); if (m2x < c2r) solapamientoMm += (c2r - m2x) * 2;\nconst m2y = halfH - Math.abs(c2y); if (m2y < c2r) solapamientoMm += (c2r - m2y) * 2;\nconst m3x = halfW - Math.abs(c3x); if (m3x < c3r) solapamientoMm += (c3r - m3x) * 2;\nconst m3y = halfH - Math.abs(c3y); if (m3y < c3r) solapamientoMm += (c3r - m3y) * 2;\n\n// Cortocircuito de alto rendimiento si hay colisión física evidente\nif (solapamientoMm > 0) {\n  const pen = 100 + solapamientoMm * 15;\n  return [75.0 + pen, 35.0 + pen * 0.5];\n}\n\n// Muestreo del campo térmico en grilla 16x13 ultra-rápida\nconst nx = 16, ny = 13;\nconst dxStep = anchoPlaca / (nx - 1), dyStep = altoPlaca / (ny - 1);\nlet tMax = tAmbiente, sumaT = 0;\nconst inv380 = 1.0 / 380.0;\n\nfor (let iy = 0; iy < ny; iy++) {\n  const y = -halfH + iy * dyStep;\n  const dyH = halfH - Math.abs(y);\n  for (let ix = 0; ix < nx; ix++) {\n    const x = -halfW + ix * dxStep;\n    const dxW = halfW - Math.abs(x);\n    const enfriamiento = (dxW < dyH ? dxW : dyH) / 15.0;\n    const conveccion = enfriamiento < 0.2 ? 0.2 : (enfriamiento > 1.0 ? 1.0 : enfriamiento);\n\n    const d0 = (x - c0x) * (x - c0x) + (y - c0y) * (y - c0y);\n    const d1 = (x - c1x) * (x - c1x) + (y - c1y) * (y - c1y);\n    const d2 = (x - c2x) * (x - c2x) + (y - c2y) * (y - c2y);\n    const d3 = (x - c3x) * (x - c3x) + (y - c3y) * (y - c3y);\n\n    const t = tAmbiente + (c0a * Math.exp(-d0 * inv380) +\n                           c1a * Math.exp(-d1 * inv380) +\n                           c2a * Math.exp(-d2 * inv380) +\n                           c3a * Math.exp(-d3 * inv380)) * conveccion;\n    if (t > tMax) tMax = t;\n    sumaT += t;\n  }\n}\nconst tPromedio = sumaT / (nx * ny);\nreturn [tMax, tMax - tPromedio];",
